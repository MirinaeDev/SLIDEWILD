file(READ "${ROOT}/shaders/metal/manifest.json" manifest)
file(SHA256 "${ROOT}/shaders/world.hlsl" source_hash)
string(JSON expected GET "${manifest}" source_sha256)
if(NOT source_hash STREQUAL expected)
    message(FATAL_ERROR "Metal shaders are stale: regenerate with tools/generate_metal.py after editing world.hlsl.")
endif()
foreach(stage vs ps shadow)
    foreach(ext msl json)
        set(name "world.${stage}.${ext}")
        string(JSON expected GET "${manifest}" files "${name}")
        file(SHA256 "${ROOT}/shaders/metal/${name}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Modified or damaged Metal asset: ${name}. Regenerate the shader set.")
        endif()
    endforeach()
endforeach()
message(STATUS "Metal source and six generated files: SHA256 verified")
