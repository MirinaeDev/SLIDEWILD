file(READ "${ROOT}/src/renderer.cpp" renderer)
string(REGEX MATCH "const char\\* names\\[\\]=\\{([^}]+)\\}" array "${renderer}")
if(NOT array)
    message(FATAL_ERROR "Runtime artwork list not found in renderer.cpp")
endif()
string(REGEX MATCHALL "\"[^\"]+\"" names "${array}")
list(LENGTH names count)
if(NOT count EQUAL 82)
    message(FATAL_ERROR "Runtime artwork list changed: update the release inventory (${count} assets)")
endif()
file(MAKE_DIRECTORY "${DEST}/assets" "${DEST}/shaders" "${DEST}/licenses")
foreach(quoted IN LISTS names)
    string(REPLACE "\"" "" name "${quoted}")
    file(COPY_FILE "${ROOT}/assets/${name}.rgba" "${DEST}/assets/${name}.rgba" ONLY_IF_DIFFERENT)
endforeach()
foreach(track menu course)
    file(MAKE_DIRECTORY "${DEST}/assets/music")
    file(COPY_FILE "${ROOT}/assets/music/${track}.wav" "${DEST}/assets/music/${track}.wav" ONLY_IF_DIFFERENT)
endforeach()
foreach(stage vs ps shadow)
    file(COPY_FILE "${SHADER_DIR}/world.${stage}.${SHADER_EXT}" "${DEST}/shaders/world.${stage}.${SHADER_EXT}" ONLY_IF_DIFFERENT)
endforeach()
file(GLOB notices "${ROOT}/licenses/*.txt")
foreach(notice IN LISTS notices)
    get_filename_component(name "${notice}" NAME)
    file(COPY_FILE "${notice}" "${DEST}/licenses/${name}" ONLY_IF_DIFFERENT)
endforeach()
file(COPY_FILE "${ROOT}/docs/MACOS-BUILD.txt" "${DEST}/MACOS-BUILD.txt" ONLY_IF_DIFFERENT)
file(COPY_FILE "${ROOT}/docs/CREDITS.md" "${DEST}/CREDITS.md" ONLY_IF_DIFFERENT)
message(STATUS "Staged ${count} artwork files and 3 ${SHADER_EXT} shaders into ${DEST}")
